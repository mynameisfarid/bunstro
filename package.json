{
  "name": "bunstro",
  "version": "1.0.0",
  "description": "Production-ready fullstack framework with pure Bun native runtime",
  "type": "module",
  "scripts": {
    "dev": "bun --watch ./index.ts",
    "dev:api": "APP=api bun --watch ./applications/api/index.ts",
    "dev:dashboard": "APP=dashboard bun --watch ./applications/dashboard/index.ts",
    "dev:tenant": "APP=tenant bun --watch ./applications/tenant/index.ts",
    "dev:web": "APP=web bun --watch ./applications/web/index.ts",
    "dev:blog": "APP=blog bun --watch ./applications/blog/index.ts",
    "dev:multi": "concurrently \"bun run dev:api\" \"bun run dev:dashboard\" \"bun run dev:tenant\" \"bun run dev:web\" \"bun run dev:blog\"",
    "start": "NODE_ENV=production bun ./index.ts",
    "start:api": "NODE_ENV=production APP=api bun ./applications/api/index.ts",
    "start:dashboard": "NODE_ENV=production APP=dashboard bun ./applications/dashboard/index.ts",
    "start:tenant": "NODE_ENV=production APP=tenant bun ./applications/tenant/index.ts",
    "start:web": "NODE_ENV=production APP=web bun ./applications/web/index.ts",
    "start:blog": "NODE_ENV=production APP=blog bun ./applications/blog/index.ts",
    "build": "bun build ./index.ts --outdir=dist --target=bun --minify",
    "cli": "bun ./cli/index.ts",
    "make:controller": "bun ./cli/index.ts make:controller",
    "make:model": "bun ./cli/index.ts make:model",
    "make:migration": "bun ./cli/index.ts make:migration",
    "migrate:latest": "bun ./cli/index.ts migrate:latest",
    "migrate:rollback": "bun ./cli/index.ts migrate:rollback",
    "migrate:status": "bun ./cli/index.ts migrate:status",
    "db:seed": "bun ./cli/index.ts db:seed",
    "route:list": "bun ./cli/index.ts route:list",
    "test": "bun test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "cookie": "^0.7.2",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.1",
    "inquirer": "^12.3.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "nanoid": "^5.0.9",
    "ora": "^8.1.1",
    "pg": "^8.13.1",
    "postgres": "^3.4.8",
    "ventojs": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "latest",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mime-types": "^2.1.4",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.8",
    "mitata": "^1.0.34"
  }
}