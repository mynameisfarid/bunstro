      <script defer src="https://unpkg.com/alpinejs@3.13.3/dist/cdn.min.js"></script>
        
        <link rel="shortcut icon" href="/dashboard/images/companies/img-8.png">
          
          <link href="/dashboard/libs/jsvectormap/css/jsvectormap.min.css" rel="stylesheet" type="text/css" />
                 <link href="/dashboard/libs/swiper/swiper-bundle.min.css" rel="stylesheet" type="text/css" />
          
          <link rel="stylesheet" type="text/css" href="/dashboard/libs/multi.js/multi.min.css" />
          
