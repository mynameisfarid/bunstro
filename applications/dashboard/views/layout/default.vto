      <script src="https://cdn.lordicon.com/lordicon.js"></script>
        
        <!-- DataTables -->
      <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
      <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
      <script src="https://cdn.datatables.net/responsive/2.2.9/js/dataTables.responsive.min.js"></script>
      <script src="https://cdn.datatables.net/buttons/2.2.2/js/dataTables.buttons.min.js"></script>
      <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.print.min.js"></script>
      <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.html5.min.js"></script>
        
        <!-- CKEDITOR -->
      <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/super-build/ckeditor.js"></script>
        
      <script src="/assets/js/csrf-token.js"></script>
        
      <script src="https://www.google.com/recaptcha/api.js"></script>
        
        <script type="text/javascript">
          
          const confirm_modal_el = document.querySelector('#confirm-modal');
          const confirm_modal = bootstrap.Modal.getOrCreateInstance(confirm_modal_el);
          function showConfirmModal(message) {
          return new Promise((resolve) => {
          // const modal = new bootstrap.Modal(document.getElementById('confirm-modal'));
          document.getElementById('warning-message').textContent = message;
          
          // Handle "Yes" button click
          document.getElementById('confirmYes').onclick = function () {
          resolve(true);
          confirm_modal.hide();
          };
          
          // Handle "Cancel" button click or close
          confirm_modal_el.addEventListener('hidden.bs.modal', function (event) {
          resolve(false);
          })
          
          confirm_modal.show();
          });
          }
          
          $('a[href*="/destroy"]').click(async function(e){
          e.preventDefault();
          const confirmed = await showConfirmModal("Do you really want to delete this item?");
          if (confirmed) {
          window.location.href = $(this).attr('href');
          } else {
          return false;
          }
          });
          
          $('a.send-confirm-btn').click(async function(e){
          e.preventDefault();
          const confirmed = await showConfirmModal("I confirm that the data submitted is valid and legitimate according to the applicable provisions.");
          if (confirmed) {
          window.location.href = $(this).attr('href');
          } else {
          return false;
          }
          });
          
          window.acl = [];
          
          function parseRouteNameFromUrl(url) {
          try {
          let u = new URL(url, window.location.origin); // supaya relative URL aman
          let path = u.pathname.replace(/^\/+|\/+$/g, ""); // trim "/"
          
          let parts = path.split("/");
          
          // Ambil hanya 2 segment pertama → contoh: role/search/1 → role.search
          if (parts.length >= 2) {
          return parts[0] + "." + parts[1];
          } else if (parts.length === 1) {
          return parts[0];
          }
          return null;
          } catch (e) {
          return null;
          }
          }
          
          function canByUrl(url) {
          let routeName = parseRouteNameFromUrl(url);
          return routeName && (window.acl.includes(routeName) || window.acl.includes(routeName.split('.')[0]+'.*'));
          }
          
          function applyPermissionCheck() {
          if( window.acl.includes("*") ) return;
          
          document.querySelectorAll("td a[href]").forEach(link => {
          let href = link.getAttribute("href");
          
          // skip anchor kosong / #
          if (!href || href.startsWith("#")) return;
          
          if (!canByUrl(href)) {
          // cara 1: hide
          link.classList.add("d-none");
          
          // cara 2: disable (opsional, pilih salah satu)
          // link.addEventListener("click", e => e.preventDefault());
          // link.style.pointerEvents = "none";
          // link.style.opacity = "0.5";
          }
          });
          }
          
          
          document.addEventListener("DOMContentLoaded", function() {
          applyPermissionCheck();
          });
          
          
        </script>
        <script>
          // Auto hide toasts after 3 seconds
          document.addEventListener('DOMContentLoaded', function() {
          const toasts = document.querySelectorAll('.toast');
          toasts.forEach(toast => {
          setTimeout(() => {
          toast.classList.remove('show');
          }, 3000);
          });
          });
          
          // Reload table on data change
          document.addEventListener('dataChanged', function() {
          htmx.trigger('#data-table', 'refresh');
          });
        </script>
        
        {{ if scripts }}
          {{ scripts }}
        {{ /if }}
  </body>
  
</html>
