    <div class="modal" id="confirm-modal" tabindex="-1" style="display: none;" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-fullscreenssss">
        <div class="modal-content">
          <div class="modal-body text-center p-5">
            <lord-icon src="https://cdn.lordicon.com/tdrtiskw.json" trigger="loop"
            colors="primary:#121331,secondary:#f06548" style="width:120px;height:120px">
                </lord-icon>
                
