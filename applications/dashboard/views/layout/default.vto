          <div class="modal-footer">
              <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
              <button type="button" class="btn btn-primary" id="confirmYes">Yes, continue</button>
          </div>
        </div><!-- /.modal-content -->
