      <script>document.write(new Date().getFullYear())</script> © Karir Dashboard.
              </div>
              <div class="col-sm-6">
                <div class="text-sm-end d-none d-sm-block">
                  Design & Develop by Farid
                </div>
              </div>
            </div>
          </div>
        </footer>
        
        
